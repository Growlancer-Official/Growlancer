-1 ring-slate-200 flex items-center justify-center flex-shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-x text-slate-400 w-4 h-4" aria-hidden="true"><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg></div><div><div class="text-xs font-bold text-slate-400 uppercase tracking-widest">Traditional</div><div class="text-sm text-slate-500">Tools scattered across chats and docs</div></div></div></div></div></div><div class="grid grid-cols-1 md:grid-cols-2 gap-3 lg:gap-3"><div class="group bg-white rounded-xl p-3 lg:p-7 border border-slate-200/60 shadow-sm hover:shadow-lg hover:border-emerald-200 transition-all duration-300 relative overflow-hidden"><div class="absolute inset-0 bg-gradient-to-br from-emerald-500/10 to-emerald-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div><div class="relative flex items-start gap-3"><div class="h-12 w-12 rounded-xl flex items-center justify-center shrink-0 bg-emerald-100 text-emerald-600 group-hover:scale-110 transition-transform duration-300"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cpu w-6 h-6" aria-hidden="true"><path d="M12 20v2"></path><path d="M12 2v2"></path><path d="M17 20v2"></path><path d="M17 2v2"></path><path d="M2 12h2"></path><path d="M2 17h2"></path><path d="M2 7h2"></path><path d="M20 12h2"></path><path d="M20 17h2"></path><path d="M20 7h2"></path><path d="M7 20v2"></path><path d="M7 2v2"></path><rect x="4" y="4" width="16" height="16" rx="2"></rect><rect x="8" y="8" width="8" height="8" rx="1"></rect></svg></div><div><h3 class="text-base font-bold text-slate-900 mb-1.5">AI-Powered Precision</h3><p class="text-sm text-slate-500 leading-relaxed">Our multi-variable engine evaluates skills, experience, availability, and past performance to deliver ranked matches — not spam proposals.</p></div></div></div><div class="group bg-white rounded-xl p-3 lg:p-7 border border-slate-200/60 shadow-sm hover:shadow-lg hover:border-teal-200 transition-all duration-300 relative overflow-hidden"><div class="absolute inset-0 bg-gradient-to-br from-teal-500/10 to-teal-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div><div class="relative flex items-start gap-3"><div class="h-12 w-12 rounded-xl flex items-center justify-center shrink-0 bg-teal-100 text-teal-600 group-hover:scale-110 transition-transform duration-300"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check w-6 h-6" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg></div><div><h3 class="text-base font-bold text-slate-900 mb-1.5">Escrow-First Trust</h3><p class="text-sm text-slate-500 leading-relaxed">Every contract is protected by secure escrow. Funds release only when milestones are approved — safety for both sides.</p></div></div></div><div class="group bg-white rounded-xl p-3 lg:p-7 border border-slate-200/60 shadow-sm hover:shadow-lg hover:border-amber-200 transition-all duration-300 relative overflow-hidden"><div class="absolute inset-0 bg-gradient-to-br from-amber-500/10 to-amber-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div><div class="relative flex items-start gap-3"><div class="h-12 w-12 rounded-xl flex items-center justify-center shrink-0 bg-amber-100 text-amber-600 group-hover:scale-110 transition-transform duration-300"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users w-6 h-6" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg></div><div><h3 class="text-base font-bold text-slate-900 mb-1.5">Built for Collaboration</h3><p class="text-sm text-slate-500 leading-relaxed">Shared workspaces with task boards, notes, and real-time updates keep everyone aligned. No context-switching across tools.</p></div></div></div><div class="group bg-white rounded-xl p-3 lg:p-7 border border-slate-200/60 shadow-sm hover:shadow-lg hover:border-orange-200 transition-all duration-300 relative overflow-hidden"><div class="absolute inset-0 bg-gradient-to-br from-orange-500/10 to-orange-600/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div><div class="relative flex items-start gap-3"><div class="h-12 w-12 rounded-xl flex items-center justify-center shrink-0 bg-orange-100 text-orange-600 group-hover:scale-110 transition-transform duration-300"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chart-column lucide-bar-chart-3 w-6 h-6" aria-hidden="true"><path d="M3 3v16a2 2 0 0 0 2 2h16"></path><path d="M18 17V9"></path><path d="M13 17V5"></path><path d="M8 17v-3"></path></svg></div><div><h3 class="text-base font-bold text-slate-900 mb-1.5">Data-Driven Growth</h3><p class="text-sm text-slate-500 leading-relaxed">Actionable analytics and transparent success metrics help you make better hiring and freelancing decisions every time.</p></div></div></div></div></div></section><section class="py-6 sm:py-8 lg:py-10"><div class="mx-auto max-w-[100rem] px-4 sm:px-6 lg:px-8 2xl:px-12"><div class="grid grid-cols-1 lg:grid-cols-12 gap-3 lg:gap-3"><div class="lg:col-span-7 rounded-xl bg-white ring-1 ring-slate-200/70 shadow-sm p-3 sm:p-4 lg:p-10"><div><div class="text-xs font-semibold text-emerald-600 uppercase tracking-widest mb-1">For freelancers</div><h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 font-display">Stop chasing projects</h2><p class="mt-3 text-sm sm:text-base text-slate-600 leading-relaxed max-w-xl">Get matched automatically to work that fits your skills, availability, and preferences. Spend time delivering, not pitching.</p></div><div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3"><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:bg-emerald-50/50 hover:ring-emerald-200/50 transition-all duration-200"><div class="flex items-center gap-3 mb-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-git-compare text-slate-600 w-4 h-4" aria-hidden="true"><circle cx="18" cy="18" r="3"></circle><circle cx="6" cy="6" r="3"></circle><path d="M13 6h3a2 2 0 0 1 2 2v7"></path><path d="M11 18H8a2 2 0 0 1-2-2V9"></path></svg><div class="text-sm font-semibold text-slate-900">Get matched automatically</div></div><div class="text-xs sm:text-sm text-slate-500">Your profile acts like an always-on application, without spam.</div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:bg-emerald-50/50 hover:ring-emerald-200/50 transition-all duration-200"><div class="flex items-center gap-3 mb-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-briefcase-business text-slate-600 w-4 h-4" aria-hidden="true"><path d="M12 12h.01"></path><path d="M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"></path><path d="M22 13a18.15 18.15 0 0 1-20 0"></path><rect width="20" height="14" x="2" y="6" rx="2"></rect></svg><div class="text-sm font-semibold text-slate-900">Relevant projects only</div></div><div class="text-xs sm:text-sm text-slate-500">Better fit means better outcomes and repeat work.</div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:bg-emerald-50/50 hover:ring-emerald-200/50 transition-all duration-200"><div class="flex items-center gap-3 mb-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wallet text-slate-600 w-4 h-4" aria-hidden="true"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"></path><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path></svg><div class="text-sm font-semibold text-slate-900">Earn faster</div></div><div class="text-xs sm:text-sm text-slate-500">Milestones and escrow help you ship and get paid on time.</div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:bg-emerald-50/50 hover:ring-emerald-200/50 transition-all duration-200"><div class="flex items-center gap-3 mb-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-messages-square text-slate-600 w-4 h-4" aria-hidden="true"><path d="M16 10a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 14.286V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path><path d="M20 9a2 2 0 0 1 2 2v10.286a.71.71 0 0 1-1.212.502l-2.202-2.202A2 2 0 0 0 17.172 19H10a2 2 0 0 1-2-2v-1"></path></svg><div class="text-sm font-semibold text-slate-900">Collaborate easily</div></div><div class="text-xs sm:text-sm text-slate-500">Files, feedback, and updates stay connected to the project.</div></div></div><div class="mt-7 flex flex-col sm:flex-row gap-3"><button class="inline-flex items-center justify-center h-11 px-5 rounded-xl bg-emerald-600 text-white font-semibold shadow-sm hover:bg-emerald-700 hover:shadow-md transition-all text-sm">Create Freelancer Profile<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button><a class="inline-flex items-center justify-center h-11 px-5 rounded-xl bg-white text-slate-700 font-semibold ring-1 ring-slate-300 hover:bg-slate-50 hover:ring-slate-400 transition-all text-sm" href="/features">Explore features</a></div></div><div class="lg:col-span-5 rounded-xl bg-slate-900 text-white shadow-sm p-3 sm:p-4 lg:p-10 relative overflow-hidden"><div class="absolute -top-16 -right-20 h-56 w-56 rounded-full bg-emerald-600/20"></div><div class="absolute -bottom-16 -left-20 h-56 w-56 rounded-full bg-orange-500/15"></div><div class="relative"><div class="text-xs font-semibold text-white/50 uppercase tracking-widest">Freelancer-first detail</div><div class="mt-2 text-xl sm:text-2xl font-bold tracking-tight font-display">Signal-based matching</div><p class="mt-3 text-sm text-white/70 leading-relaxed">Your availability, focus areas, and recent work matter. Growlancer prioritizes fit over volume.</p><div class="mt-6 space-y-3"><div class="rounded-xl bg-white/10 ring-1 ring-white/10 p-3.5 hover:bg-white/15 transition-colors"><div class="flex items-center justify-between gap-3 mb-1"><div class="text-sm font-medium text-white">Profile clarity</div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-scan-text text-white/60 w-4 h-4" aria-hidden="true"><path d="M3 7V5a2 2 0 0 1 2-2h2"></path><path d="M17 3h2a2 2 0 0 1 2 2v2"></path><path d="M21 17v2a2 2 0 0 1-2 2h-2"></path><path d="M7 21H5a2 2 0 0 1-2-2v-2"></path><path d="M7 8h8"></path><path d="M7 12h10"></path><path d="M7 16h6"></path></svg></div><div class="text-xs text-white/60">Skills, samples, and scope preference are structured.</div></div><div class="rounded-xl bg-white/10 ring-1 ring-white/10 p-3.5 hover:bg-white/15 transition-colors"><div class="flex items-center justify-between gap-3 mb-1"><div class="text-sm font-medium text-white">Availability signals</div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-calendar-check text-white/60 w-4 h-4" aria-hidden="true"><path d="M8 2v3"></path><path d="M16 2v3"></path><rect x="3" y="3" width="18" height="18" rx="2"></rect><path d="M3 9h18"></path><path d="m9 15 2 2 4-4"></path></svg></div><div class="text-xs text-white/60">Opt in to match windows, not constant bidding.</div></div><div class="rounded-xl bg-white/10 ring-1 ring-white/10 p-3.5 hover:bg-white/15 transition-colors"><div class="flex items-center justify-between gap-3 mb-1"><div class="text-sm font-medium text-white">Workflow readiness</div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-square-check-big lucide-check-square text-white/60 w-4 h-4" aria-hidden="true"><path d="M21 10.656V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h12.344"></path><path d="m9 11 3 3L22 4"></path></svg></div><div class="text-xs text-white/60">Milestones and deliverables reduce misalignment.</div></div></div></div></div></div></div></section><section class="py-5 sm:py-14 lg:py-8"><div class="mx-auto max-w-[100rem] px-4 sm:px-6 lg:px-8 2xl:px-12"><div class="grid grid-cols-1 lg:grid-cols-12 gap-3 lg:gap-3"><div class="lg:col-span-5 rounded-xl bg-white ring-1 ring-slate-200/70 shadow-sm p-3 sm:p-4 flex flex-col"><div class="flex items-center gap-3 mb-2"><div class="h-10 w-10 rounded-xl bg-orange-50 ring-1 ring-orange-100 flex items-center justify-center"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-timer text-orange-600 w-5 h-5" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg></div><div><div class="text-xs font-semibold text-slate-400 uppercase tracking-widest">For clients</div><div class="text-lg font-bold tracking-tight text-slate-900">Stop wasting time hiring</div></div></div><ul class="space-y-3 text-sm text-slate-600"><li class="flex gap-3.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 text-emerald-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><div><span class="font-semibold text-slate-800">Instant AI recommendations</span>that fit your project constraints.</div></li><li class="flex gap-3.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 text-emerald-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><div><span class="font-semibold text-slate-800">No spam proposals</span>— you invite who you want to talk to.</div></li><li class="flex gap-3.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 text-emerald-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><div><span class="font-semibold text-slate-800">Hire quickly</span>with milestones and escrow ready to go.</div></li><li class="flex gap-3.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 text-emerald-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><div><span class="font-semibold text-slate-800">Track projects easily</span>with a shared workspace for delivery.</div></li></ul><div class="mt-5 grid grid-cols-3 gap-3"><div class="rounded-lg bg-slate-50 ring-1 ring-slate-200/70 px-2 py-2.5 flex items-center justify-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check text-emerald-600 w-4 h-4 flex-shrink-0" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg><span class="text-xs font-semibold text-slate-600 leading-tight">Escrow protection</span></div><div class="rounded-lg bg-slate-50 ring-1 ring-slate-200/70 px-2 py-2.5 flex items-center justify-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap text-emerald-600 w-4 h-4 flex-shrink-0" aria-hidden="true"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"></path></svg><span class="text-xs font-semibold text-slate-600 leading-tight">Real-time updates</span></div><div class="rounded-lg bg-slate-50 ring-1 ring-slate-200/70 px-2 py-2.5 flex items-center justify-center gap-1.5"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-badge-check lucide-verified text-emerald-600 w-4 h-4 flex-shrink-0" aria-hidden="true"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path><path d="m16 9-5.5 5.5L8 12"></path></svg><span class="text-xs font-semibold text-slate-600 leading-tight">KYC-verified talent</span></div></div><div class="mt-4 flex-1 flex flex-col justify-center rounded-xl bg-gradient-to-br from-emerald-50 via-teal-50/60 to-white ring-1 ring-emerald-100/70 px-4 py-3.5"><div class="flex items-center gap-3 mb-2.5"><span class="relative flex h-2 w-2"><span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span></span><span class="text-xs font-semibold text-emerald-700 uppercase tracking-wider">Live platform metrics</span></div><div class="grid grid-cols-3 gap-3"><div class="rounded-lg bg-white/90 ring-1 ring-emerald-100/70 py-2.5 px-1 text-center"><div class="text-base sm:text-lg font-bold text-slate-900 leading-none">…</div><div class="text-xs text-slate-500 mt-1.5 leading-tight">Members</div></div><div class="rounded-lg bg-white/90 ring-1 ring-emerald-100/70 py-2.5 px-1 text-center"><div class="text-base sm:text-lg font-bold text-slate-900 leading-none">…</div><div class="text-xs text-slate-500 mt-1.5 leading-tight">Escrow protected</div></div><div class="rounded-lg bg-white/90 ring-1 ring-emerald-100/70 py-2.5 px-1 text-center"><div class="text-base sm:text-lg font-bold text-slate-900 leading-none">…</div><div class="text-xs text-slate-500 mt-1.5 leading-tight">Satisfaction</div></div></div></div><div class="mt-5 flex flex-col sm:flex-row gap-3"><button class="inline-flex items-center justify-center h-11 px-5 rounded-xl bg-emerald-600 text-white font-semibold shadow-sm hover:bg-emerald-700 hover:shadow-md transition-all text-sm">Get Started<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button><a class="inline-flex items-center justify-center h-11 px-5 rounded-xl bg-white text-slate-700 font-semibold ring-1 ring-slate-300 hover:bg-slate-50 hover:ring-slate-400 transition-all text-sm" href="/categories">Browse categories</a></div></div><div class="lg:col-span-7 rounded-xl bg-white ring-1 ring-slate-200/70 shadow-sm p-3 sm:p-4"><div><div class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Client workflow preview</div><h3 class="mt-2 text-xl sm:text-2xl font-bold tracking-tight text-slate-900 font-display">From brief to escrow, without tool chaos</h3><p class="mt-2 text-sm text-slate-600 leading-relaxed max-w-xl">Define scope, invite matches, and collaborate in a structured workspace that keeps delivery predictable.</p></div><div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-3"><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:bg-orange-50/50 hover:ring-orange-200/50 transition-all duration-200"><div class="flex items-center justify-between mb-1"><div class="text-sm font-semibold text-slate-900">Milestones</div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-flag text-slate-400 w-4 h-4" aria-hidden="true"><path d="M4 22V4a1 1 0 0 1 .4-.8A6 6 0 0 1 8 2c3 0 5 2 7.333 2q2 0 3.067-.8A1 1 0 0 1 20 4v10a1 1 0 0 1-.4.8A6 6 0 0 1 16 16c-3 0-5-2-8-2a6 6 0 0 0-4 1.528"></path></svg></div><div class="text-xs sm:text-sm text-slate-500">Break work into clear deliverables with approvals.</div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:bg-orange-50/50 hover:ring-orange-200/50 transition-all duration-200"><div class="flex items-center justify-between mb-1"><div class="text-sm font-semibold text-slate-900">Escrow</div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock text-slate-400 w-4 h-4" aria-hidden="true"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg></div><div class="text-xs sm:text-sm text-slate-500">Secure escrow helps both sides move forward confidently.</div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:bg-orange-50/50 hover:ring-orange-200/50 transition-all duration-200"><div class="flex items-center justify-between mb-1"><div class="text-sm font-semibold text-slate-900">Feedback loop</div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-message-square-text text-slate-400 w-4 h-4" aria-hidden="true"><path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path><path d="M7 11h10"></path><path d="M7 15h6"></path><path d="M7 7h8"></path></svg></div><div class="text-xs sm:text-sm text-slate-500">Comments and revisions stay tied to the work.</div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:bg-orange-50/50 hover:ring-orange-200/50 transition-all duration-200"><div class="flex items-center justify-between mb-1"><div class="text-sm font-semibold text-slate-900">Status clarity</div><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-activity text-slate-400 w-4 h-4" aria-hidden="true"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path></svg></div><div class="text-xs sm:text-sm text-slate-500">Track progress with simple, consistent states.</div></div></div><div class="mt-5 rounded-xl bg-emerald-50 ring-1 ring-emerald-100/70 p-4"><div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3"><div class="flex items-center gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-zap text-emerald-600 w-4 h-4" aria-hidden="true"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"></path></svg><span class="text-sm font-semibold text-slate-800">Real-time ready by design</span></div><span class="text-xs sm:text-sm text-slate-500">Messages, milestones, and escrow updates sync live.</span></div></div></div></div></div></section><section class="py-6 sm:py-8 lg:py-10 bg-white"><div class="mx-auto max-w-[100rem] px-4 sm:px-6 lg:px-8 2xl:px-12"><div class="flex flex-col items-center text-center lg:text-left lg:flex-row lg:items-end lg:justify-between gap-3 mb-2 lg:mb-10"><div class="max-w-2xl"><div class="text-xs font-semibold text-emerald-600 uppercase tracking-widest mb-2">Categories</div><h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 font-display">Browse All Categories</h2><p class="mt-2 text-sm sm:text-base text-slate-600 leading-relaxed max-w-xl mx-auto lg:mx-0">Loading categories...</p></div><div class="flex items-center gap-3"><a class="inline-flex items-center justify-center h-10 px-4 rounded-xl bg-white text-slate-700 font-semibold ring-1 ring-slate-300 hover:bg-slate-50 hover:ring-slate-400 transition-all text-sm" href="/categories">View All<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a><button class="inline-flex items-center justify-center h-10 px-4 rounded-xl bg-emerald-600 text-white font-semibold hover:bg-emerald-700 transition-all text-sm shadow-sm">Hire talent<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button></div></div><div><div><div class="flex items-center justify-center py-8"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-loader-circle lucide-loader-2 w-6 h-6 animate-spin text-emerald-600" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.219-8.56"></path></svg></div></div></div><div class="mt-6 text-center"><a class="inline-flex items-center gap-3 px-5 py-2.5 bg-white text-emerald-600 font-semibold rounded-xl border border-emerald-200 hover:bg-emerald-50 hover:border-emerald-300 transition-all text-sm shadow-sm" href="/categories"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-layers lucide-layers-3 w-4 h-4" aria-hidden="true"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path></svg>Explore All <!-- -->0<!-- --> Categories<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></a></div></div></section><section class="py-6 sm:py-8 lg:py-10 bg-white"><div class="mx-auto max-w-[100rem] px-4 sm:px-6 lg:px-8 2xl:px-12"><div class="rounded-xl bg-white ring-1 ring-slate-200/70 shadow-sm overflow-hidden"><div class="p-3 sm:p-4 lg:p-10"><div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-3"><div class="max-w-2xl"><div class="text-xs font-semibold text-violet-600 uppercase tracking-widest mb-2">Team Projects</div><h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 font-display">Hire a whole team for big projects</h2><p class="mt-2 text-sm sm:text-base text-slate-600 leading-relaxed">Designer, Developer, Writer — all in one place. Each freelancer has their<!-- --> <strong class="text-slate-800">own protected escrow</strong>, and each role gets its own independent contract — one member&#x27;s issue never affects the rest of the team.</p><button class="mt-5 inline-flex items-center justify-center h-11 px-5 rounded-xl bg-emerald-600 text-white font-semibold shadow-sm hover:bg-emerald-700 hover:shadow-md transition-all text-sm">Post a Team Project<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button></div><div class="rounded-xl bg-emerald-50 ring-1 ring-emerald-100/70 p-4 w-full lg:w-[380px] shrink-0"><div class="flex items-start gap-3"><div class="h-9 w-9 rounded-xl bg-white ring-1 ring-violet-100 flex items-center justify-center shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users text-violet-600 w-4 h-4" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg></div><div><div class="text-sm font-semibold text-slate-800">How team hiring works</div><div class="mt-0.5 text-xs text-slate-500 leading-relaxed">Add a role → AI matches in real time → each role gets its own independent escrow contract. Commission (5%) per contract — no separate team fee.</div></div></div></div></div><div class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3"><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:shadow-sm transition-all"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-receipt text-violet-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M12 17V7"></path><path d="M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8"></path><path d="M4 3a1 1 0 0 1 1-1 1.3 1.3 0 0 1 .7.2l.933.6a1.3 1.3 0 0 0 1.4 0l.934-.6a1.3 1.3 0 0 1 1.4 0l.933.6a1.3 1.3 0 0 0 1.4 0l.933-.6a1.3 1.3 0 0 1 1.4 0l.934.6a1.3 1.3 0 0 0 1.4 0l.933-.6A1.3 1.3 0 0 1 19 2a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1 1.3 1.3 0 0 1-.7-.2l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.934.6a1.3 1.3 0 0 1-1.4 0l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-1.4 0l-.934-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-.7.2 1 1 0 0 1-1-1z"></path></svg><div><div class="text-sm font-semibold text-slate-800">Only 5% commission</div><div class="mt-0.5 text-xs text-slate-500 leading-relaxed">Flat and transparent — charged from the client. No hidden fees.</div></div></div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:shadow-sm transition-all"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock-keyhole text-violet-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><circle cx="12" cy="16" r="1"></circle><rect x="3" y="10" width="18" height="12" rx="2"></rect><path d="M7 10V7a5 5 0 0 1 10 0v3"></path></svg><div><div class="text-sm font-semibold text-slate-800">Escrow protection</div><div class="mt-0.5 text-xs text-slate-500 leading-relaxed">Money releases only when you approve the delivered work.</div></div></div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:shadow-sm transition-all"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-timer text-violet-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><line x1="10" x2="14" y1="2" y2="2"></line><line x1="12" x2="15" y1="14" y2="11"></line><circle cx="12" cy="14" r="8"></circle></svg><div><div class="text-sm font-semibold text-slate-800">Auto-release safety net</div><div class="mt-0.5 text-xs text-slate-500 leading-relaxed">Silent client? Verified work auto-releases after the review window.</div></div></div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:shadow-sm transition-all"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-badge-check lucide-verified text-violet-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"></path><path d="m16 9-5.5 5.5L8 12"></path></svg><div><div class="text-sm font-semibold text-slate-800">Verified freelancers</div><div class="mt-0.5 text-xs text-slate-500 leading-relaxed">ID-verified and skill-certified badges on every profile.</div></div></div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:shadow-sm transition-all"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars text-violet-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg><div><div class="text-sm font-semibold text-slate-800">AI matching, free for clients</div><div class="mt-0.5 text-xs text-slate-500 leading-relaxed">Instant help finding the right freelancer — free for life.</div></div></div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:shadow-sm transition-all"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users text-violet-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg><div><div class="text-sm font-semibold text-slate-800">Independent contracts</div><div class="mt-0.5 text-xs text-slate-500 leading-relaxed">One member dispute/cancellation never affects the rest of the team.</div></div></div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:shadow-sm transition-all"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check text-violet-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg><div><div class="text-sm font-semibold text-slate-800">Fair dispute resolution</div><div class="mt-0.5 text-xs text-slate-500 leading-relaxed">Clear published process — admin-reviewed, split option when fair.</div></div></div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:shadow-sm transition-all"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wallet text-violet-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"></path><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path></svg><div><div class="text-sm font-semibold text-slate-800">Instant wallet payouts</div><div class="mt-0.5 text-xs text-slate-500 leading-relaxed">Released funds land in the wallet for quick withdrawal.</div></div></div></div></div></div></div></div></section><section class="py-5 sm:py-14 lg:py-8"><div class="mx-auto max-w-[100rem] px-4 sm:px-6 lg:px-8 2xl:px-12"><div class="max-w-2xl mb-2 lg:mb-10"><div class="text-xs font-semibold text-emerald-600 uppercase tracking-widest mb-2">Features</div><h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 font-display">Product features</h2><p class="mt-2 text-sm sm:text-base text-slate-600 leading-relaxed">Minimal surface area, high leverage. Every feature supports speed, trust, and collaboration.</p></div><div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 lg:gap-3"><div class="rounded-xl bg-white ring-1 ring-slate-200/70 shadow-sm p-3 hover:ring-emerald-200 hover:shadow-md transition-all duration-200 group"><div class="h-10 w-10 rounded-xl ring-1 flex items-center justify-center bg-emerald-50 ring-emerald-100 text-emerald-600 group-hover:scale-110 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sparkles lucide-stars w-5 h-5" aria-hidden="true"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"></path><path d="M20 2v4"></path><path d="M22 4h-4"></path><circle cx="4" cy="20" r="2"></circle></svg></div><div class="mt-3.5 text-base font-semibold tracking-tight text-slate-900">AI Matching</div><p class="mt-1 text-sm text-slate-500 leading-relaxed">Ranked recommendations with explainable fit signals — built to reduce noise.</p></div><div class="rounded-xl bg-white ring-1 ring-slate-200/70 shadow-sm p-3 hover:ring-orange-200 hover:shadow-md transition-all duration-200 group"><div class="h-10 w-10 rounded-xl ring-1 flex items-center justify-center bg-orange-50 ring-orange-100 text-orange-600 group-hover:scale-110 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check w-5 h-5" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg></div><div class="mt-3.5 text-base font-semibold tracking-tight text-slate-900">Escrow Payments</div><p class="mt-1 text-sm text-slate-500 leading-relaxed">Secure escrow + milestone structure so both sides know what happens next.</p></div><div class="rounded-xl bg-white ring-1 ring-slate-200/70 shadow-sm p-3 hover:ring-slate-300 hover:shadow-md transition-all duration-200 group"><div class="h-10 w-10 rounded-xl ring-1 flex items-center justify-center bg-slate-50 ring-slate-200 text-slate-600 group-hover:scale-110 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-folder-kanban w-5 h-5" aria-hidden="true"><path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.93a2 2 0 0 1-1.66-.9l-.82-1.2A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13c0 1.1.9 2 2 2Z"></path><path d="M8 10v4"></path><path d="M12 10v2"></path><path d="M16 10v6"></path></svg></div><div class="mt-3.5 text-base font-semibold tracking-tight text-slate-900">Workspace</div><p class="mt-1 text-sm text-slate-500 leading-relaxed">Keep scope, files, feedback, and approvals connected to the project.</p></div><div class="rounded-xl bg-white ring-1 ring-slate-200/70 shadow-sm p-3 hover:ring-emerald-200 hover:shadow-md transition-all duration-200 group"><div class="h-10 w-10 rounded-xl ring-1 flex items-center justify-center bg-emerald-50 ring-emerald-100 text-emerald-600 group-hover:scale-110 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-users w-5 h-5" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><path d="M16 3.128a4 4 0 0 1 0 7.744"></path><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><circle cx="9" cy="7" r="4"></circle></svg></div><div class="mt-3.5 text-base font-semibold tracking-tight text-slate-900">Collaboration</div><p class="mt-1 text-sm text-slate-500 leading-relaxed">Invite stakeholders, set expectations, and move decisions forward quickly.</p></div></div></div></section><section class="py-6 sm:py-8 lg:py-10 bg-white"><div class="mx-auto max-w-[100rem] px-4 sm:px-6 lg:px-8 2xl:px-12"><div class="rounded-xl bg-white ring-1 ring-slate-200/70 shadow-sm overflow-hidden"><div class="p-3 sm:p-4 lg:p-10"><div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-3"><div class="max-w-2xl"><div class="text-xs font-semibold text-emerald-600 uppercase tracking-widest mb-2">Pricing</div><h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 font-display">Pricing that stays transparent</h2><p class="mt-2 text-sm sm:text-base text-slate-600 leading-relaxed">We keep pricing simple: clear fees, no pay-to-bid mechanics, and no incentives for spam.</p></div><div class="rounded-xl bg-emerald-50 ring-1 ring-emerald-100/70 p-4 w-full lg:w-[380px] shrink-0"><div class="flex items-start gap-3"><div class="h-9 w-9 rounded-xl bg-white ring-1 ring-emerald-100 flex items-center justify-center shrink-0"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-receipt text-emerald-600 w-4 h-4" aria-hidden="true"><path d="M12 17V7"></path><path d="M16 8h-6a2 2 0 0 0 0 4h4a2 2 0 0 1 0 4H8"></path><path d="M4 3a1 1 0 0 1 1-1 1.3 1.3 0 0 1 .7.2l.933.6a1.3 1.3 0 0 0 1.4 0l.934-.6a1.3 1.3 0 0 1 1.4 0l.933.6a1.3 1.3 0 0 0 1.4 0l.933-.6a1.3 1.3 0 0 1 1.4 0l.934.6a1.3 1.3 0 0 0 1.4 0l.933-.6A1.3 1.3 0 0 1 19 2a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1 1.3 1.3 0 0 1-.7-.2l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.934.6a1.3 1.3 0 0 1-1.4 0l-.933-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-1.4 0l-.934-.6a1.3 1.3 0 0 0-1.4 0l-.933.6a1.3 1.3 0 0 1-.7.2 1 1 0 0 1-1-1z"></path></svg></div><div><div class="text-sm font-semibold text-slate-800">Fee clarity, upfront</div><div class="mt-0.5 text-xs text-slate-500">Clients post without friction. Freelancers focus on fit, not bidding.</div></div></div></div></div><div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-3"><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:shadow-sm transition-all"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-shield-check text-emerald-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"></path><path d="m9 12 2 2 4-4"></path></svg><div><div class="text-sm font-semibold text-slate-800">No proposal spam</div><div class="mt-0.5 text-xs text-slate-500">The platform is designed around invites, not floods.</div></div></div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:shadow-sm transition-all"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-wallet text-emerald-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"></path><path d="M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"></path></svg><div><div class="text-sm font-semibold text-slate-800">Escrow-first workflow</div><div class="mt-0.5 text-xs text-slate-500">Milestones keep payments and deliverables aligned.</div></div></div></div><div class="rounded-xl bg-slate-50 ring-1 ring-slate-200/70 p-4 hover:shadow-sm transition-all"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-check-circle-2 text-emerald-600 w-4 h-4 mt-0.5 flex-shrink-0" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m16 9-5.5 5.5L8 12"></path></svg><div><div class="text-sm font-semibold text-slate-800">Predictable experience</div><div class="mt-0.5 text-xs text-slate-500">Clear fees, clear next steps, fewer moving parts.</div></div></div></div></div></div></div></div></section><section class="py-5 sm:py-14 lg:py-8"><div class="mx-auto max-w-[100rem] px-4 sm:px-6 lg:px-8 2xl:px-12"><div class="grid grid-cols-1 lg:grid-cols-12 gap-3 lg:gap-3"><div class="lg:col-span-5"><div class="text-xs font-semibold text-emerald-600 uppercase tracking-widest mb-2">Trust</div><h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-slate-900 font-display">Built for trust from day one</h2><p class="mt-2 text-sm sm:text-base text-slate-600 leading-relaxed">Growlancer builds trust by making the system understandable: how matching works, how payments are protected, and how projects stay organized.</p><div class="mt-6 rounded-xl bg-white ring-1 ring-slate-200/70 shadow-sm p-3 hover:shadow-md transition-all"><div class="flex items-start gap-3"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye text-emerald-600 w-5 h-5 mt-0.5 flex-shrink-0" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg><div><div class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Platform philosophy</div><div class="mt-1 text-sm font-semibold text-slate-800">Clarity beats hype.</div><div class="mt-1 text-xs text-slate-500">We avoid vanity metrics and focus on workflow transparency and safer collaboration.</div></div></div></div></div><div class="lg:col-span-7 grid grid-cols-1 md:grid-cols-3 gap-3"><div class="rounded-xl bg-white ring-1 ring-slate-200/70 shadow-sm p-3 hover:shadow-md transition-all duration-200 group"><div class="h-10 w-10 rounded-xl ring-1 flex items-center justify-center bg-slate-50 ring-slate-200 text-slate-600 group-hover:scale-110 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-eye w-5 h-5" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path><circle cx="12" cy="12" r="3"></circle></svg></div><div class="mt-3.5 text-base font-semibold tracking-tight text-slate-900">Transparency</div><p class="mt-1 text-sm text-slate-500 leading-relaxed">See fit reasons and key signals behind each recommendation.</p></div><div class="rounded-xl bg-white ring-1 ring-slate-200/70 shadow-sm p-3 hover:shadow-md transition-all duration-200 group"><div class="h-10 w-10 rounded-xl ring-1 flex items-center justify-center bg-emerald-50 ring-emerald-100 text-emerald-600 group-hover:scale-110 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-lock-keyhole w-5 h-5" aria-hidden="true"><circle cx="12" cy="16" r="1"></circle><rect x="3" y="10" width="18" height="12" rx="2"></rect><path d="M7 10V7a5 5 0 0 1 10 0v3"></path></svg></div><div class="mt-3.5 text-base font-semibold tracking-tight text-slate-900">Escrow safety</div><p class="mt-1 text-sm text-slate-500 leading-relaxed">Milestones + secure escrow support a safer payment flow.</p></div><div class="rounded-xl bg-white ring-1 ring-slate-200/70 shadow-sm p-3 hover:shadow-md transition-all duration-200 group"><div class="h-10 w-10 rounded-xl ring-1 flex items-center justify-center bg-orange-50 ring-orange-100 text-orange-600 group-hover:scale-110 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clipboard-check w-5 h-5" aria-hidden="true"><rect width="8" height="4" x="8" y="2" rx="1" ry="1"></rect><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path><path d="m9 14 2 2 4-4"></path></svg></div><div class="mt-3.5 text-base font-semibold tracking-tight text-slate-900">Workflow control</div><p class="mt-1 text-sm text-slate-500 leading-relaxed">Scope and delivery stay structured, reducing misalignment.</p></div></div></div></div></section><section class="py-5 sm:py-14 lg:py-8"><div class="mx-auto max-w-[100rem] px-4 sm:px-6 lg:px-8 2xl:px-12"><div class="relative rounded-xl bg-gradient-to-br from-slate-900 to-emerald-900 text-white shadow-xl overflow-hidden"><div class="absolute -top-16 -right-16 h-64 w-64 rounded-full bg-emerald-500/15"></div><div class="absolute -bottom-16 -left-16 h-64 w-64 rounded-full bg-emerald-600/10"></div><div class="relative p-4 sm:p-10 lg:p-12"><div class="grid grid-cols-1 lg:grid-cols-2 gap-3 items-center"><div><div class="inline-flex items-center gap-3 px-3 py-1 rounded-full bg-emerald-500/15 text-emerald-300 text-xs font-bold uppercase tracking-wider mb-2"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-clock-3 w-3.5 h-3.5" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="M12 6v6h4"></path></svg>EARLY ACCESS</div><h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight font-display">Be the first to know</h2><p class="mt-2 text-sm sm:text-base text-white/70 leading-relaxed max-w-md">We&#x27;re launching soon. Join the waitlist for early access, feature announcements, and exclusive launch offers.</p></div><div><form class="space-y-3"><div class="grid grid-cols-1 sm:grid-cols-2 gap-3"><input type="text" id="waitlist-name" aria-label="Your name" placeholder="Your name" required="" autoComplete="name" class="w-full h-12 px-4 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/50 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-emerald-400 transition-all" name="name" value=""/><input type="email" id="waitlist-email" aria-label="Email address" placeholder="you@company.com" required="" autoComplete="email" class="w-full h-12 px-4 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/50 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-emerald-400 transition-all" name="email" value=""/></div><div class="flex flex-col sm:flex-row gap-3"><select id="waitlist-country" name="country" aria-label="Country" required="" class="w-full sm:flex-1 h-12 px-4 rounded-xl bg-white/10 border border-white/20 text-white placeholder-white/50 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400 focus:border-emerald-400 transition-all [&amp;&gt;option]:text-slate-900"><option value="" selected="">Loading countries...</option></select><button type="submit" class="inline-flex items-center justify-center h-12 px-5 rounded-xl bg-emerald-500 hover:bg-emerald-400 transition-colors font-semibold text-slate-900 disabled:opacity-50 gap-3 whitespace-nowrap text-sm">Get Early Access<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button></div></form><p class="mt-2 text-xs text-white/50">No spam. Unsubscribe anytime.</p></div></div></div></div></div></section><section class="py-5 sm:py-14 lg:py-8"><div class="mx-auto max-w-[100rem] px-4 sm:px-6 lg:px-8 2xl:px-12"><div class="relative rounded-xl bg-slate-900 text-white shadow-sm overflow-hidden ring-1 ring-slate-800"><div class="absolute -top-20 -right-24 h-72 w-72 rounded-full bg-emerald-600/20"></div><div class="absolute -bottom-28 -left-28 h-80 w-80 rounded-full bg-orange-500/15"></div><div class="relative p-4 sm:p-10 lg:p-12"><div class="grid grid-cols-1 lg:grid-cols-12 gap-3 items-center"><div class="lg:col-span-7"><h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight font-display">Start your freelancing journey today.</h2><p class="mt-2 text-sm sm:text-base text-white/70 leading-relaxed max-w-xl">Whether you&#x27;re hiring or freelancing, Growlancer helps you move from intent to work faster — with less noise and more clarity.</p></div><div class="lg:col-span-5 flex flex-col sm:flex-row lg:flex-col gap-3 lg:items-stretch"><button class="inline-flex items-center justify-center h-12 px-6 rounded-xl bg-emerald-500 hover:bg-emerald-600 transition-colors font-semibold text-slate-900 w-full text-sm">Get Started<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button><button class="inline-flex items-center justify-center h-12 px-6 rounded-xl bg-white text-slate-800 hover:bg-slate-100 transition-colors font-semibold w-full text-sm">Start Freelancing<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right ml-2 w-4 h-4" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg></button><div class="text-xs text-white/50 text-center lg:text-left">No spam. No pay-to-bid. Clear workflows.</div></div></div></div></div></div></section></div></main><footer class="border-t border-slate-200 bg-white"><div class="mx-auto max-w-[100rem] px-4 sm:px-6 lg:px-8 2xl:px-12 py-8 sm:py-10"><div cl