# Copy this file to `.env` and fill in values from the Supabase dashboard:
# Project Settings → API → Project URL & anon public key
#
# Never put real secrets in `.env.example` (this file is committed to git).
# Never commit `.env` (it is gitignored).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Optional: shown in Sentry release tag / health checks
VITE_APP_VERSION=0.0.1

# Optional: Sentry browser DSN (leave empty to disable in production bundle)
VITE_SENTRY_DSN=

# ════════════════════════════════════════════
# PAYMENT PROVIDERS
# ════════════════════════════════════════════

# ── PayPal (PRIMARY DISABLED — Coming Soon) ──
# PayPal is fully implemented in the backend but hidden in the UI until live
# credentials are provisioned. Set VITE_PAYPAL_ENABLED=true (and the keys below)
# to reveal the PayPal checkout options.
VITE_PAYPAL_ENABLED=false
# Get credentials: https://developer.paypal.com/dashboard/applications
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# PayPal Webhook (set up in PayPal Developer Dashboard → Webhooks)
# URL: https://YOUR_PROJECT_REF.supabase.co/functions/v1/paypal-webhook
PAYPAL_WEBHOOK_ID=

# ── Cashfree (PRIMARY payment gateway — India) ──
# Get credentials: https://merchant.cashfree.com (Payment Gateway → API Keys)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# 'TEST' or 'PROD' — must match the dashboard environment
CASHFREE_ENVIRONMENT=TEST

# Cashfree Payouts (withdrawals) — same merchant account, separate product keys.
# Optional: if empty, the PG credentials above are used.
CASHFREE_PAYOUT_CLIENT_ID=
CASHFREE_PAYOUT_CLIENT_SECRET=

# Cashfree Webhooks (Payment Gateway → Settings → Webhooks)
# URL: https://YOUR_PROJECT_REF.supabase.co/functions/v1/cashfree-webhook
# Events: PAYMENT_SUCCESS_WEBHOOK, PAYMENT_FAILED_WEBHOOK, REFUND_STATUS_WEBHOOK
CASHFREE_WEBHOOK_SECRET=

# ════════════════════════════════════════════
# APP URL (used for PayPal return URLs)
# ════════════════════════════════════════════
# ── AI Assistant ──
# Google Gemini API key for the AI Assistant feature
# Get a key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

APP_URL=https://growlancer.vercel.app

# ════════════════════════════════════════════
# EMAIL
# ════════════════════════════════════════════
# Verification & password-reset emails are delivered by Supabase Auth's
# built-in sender (Dashboard → Authentication → Email → Confirm email ON,
# Custom SMTP OFF). No external SMTP provider is required.
