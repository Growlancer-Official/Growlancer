              "host": ["{{SUPABASE_URL}}"],
              "path": ["auth", "v1", "recover"]
            }
          },
          "response": []
        },
        {
          "name": "Google OAuth (Authorize — browser redirect)",
          "request": {
            "method": "GET",
            "description": "Opens in a browser: sign in with Google. After success, Supabase redirects to {{APP_URL}}/auth/callback. Use the app's Continue with Google button for the full flow — this endpoint initiates the OAuth dance.",
            "url": {
              "raw": "{{SUPABASE_URL}}/auth/v1/authorize?provider=google&redirect_to={{APP_URL}}/auth/callback",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["auth", "v1", "authorize"],
              "query": [
                { "key": "provider", "value": "google" },
                { "key": "redirect_to", "value": "{{APP_URL}}/auth/callback" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "LinkedIn OAuth (Authorize — browser redirect)",
          "request": {
            "method": "GET",
            "description": "Opens in a browser: sign in with LinkedIn (OIDC). After success, Supabase redirects to {{APP_URL}}/auth/callback. Use the app's Continue with LinkedIn button for the full flow.",
            "url": {
              "raw": "{{SUPABASE_URL}}/auth/v1/authorize?provider=linkedin_oidc&redirect_to={{APP_URL}}/auth/callback",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["auth", "v1", "authorize"],
              "query": [
                { "key": "provider", "value": "linkedin_oidc" },
                { "key": "redirect_to", "value": "{{APP_URL}}/auth/callback" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Magic Link (OTP Email)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{ANON_KEY}}", "type": "text" },
