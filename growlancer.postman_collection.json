              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{SUPABASE_URL}}/auth/v1/logout",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["auth", "v1", "logout"]
            }
          },
          "response": []
        },
        {
