            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{SUPABASE_URL}}/auth/v1/otp",
              "host": ["{{SUPABASE_URL}}"],
              "path": ["auth", "v1", "otp"]
            }
          },
          "response": []
        }
      ]
    },
